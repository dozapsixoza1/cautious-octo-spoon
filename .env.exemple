# Токен бота от @BotFather
BOT_TOKEN=

# Telegram-username бота без @, нужен для реферальных ссылок (t.me/username?start=ref_XXXX)
BOT_USERNAME=

# Курс: сколько GRAM выдаётся за 1 Telegram Star при пополнении
STARS_TO_GRAM_RATE=10

# Реферальный бонус в GRAM за каждого приглашённого, который выполнил первое задание
REFERRAL_BONUS=20

# --- Админ-панель ---
ADMIN_PORT=3001
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_please
SESSION_SECRET=change_this_to_random_string

# ID владельца в Telegram (числовой user id) — получает алерты и доступ к /admin-командам в самом боте
OWNER_TELEGRAM_ID=
